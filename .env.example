# PostgreSQL connection string (Neon/Supabase pooled URL is suitable)
DATABASE_URL=

# Generate with: openssl rand -base64 32
AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App settings; encode PEM newlines as \n when the host requires one line
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional global Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# Optional Gemini triage (the app works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Public canonical URL, no trailing slash
APP_URL=http://localhost:3000

# Long random secret used by /api/worker; Vercel cron sends it as Bearer CRON_SECRET
WORKER_SECRET=
CRON_SECRET=

# Optional tuning
LOG_LEVEL=info
WORKER_BATCH_SIZE=10
